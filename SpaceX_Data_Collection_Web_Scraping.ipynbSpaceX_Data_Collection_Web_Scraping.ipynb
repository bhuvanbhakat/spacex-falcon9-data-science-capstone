
# ============================================================
# SpaceX Falcon 9 Data Collection Using Web Scraping
# ============================================================

import requests
import pandas as pd
from bs4 import BeautifulSoup

# Step 1: Define the Wikipedia URL
url = "https://en.wikipedia.org/wiki/List_of_Falcon_9_and_Falcon_Heavy_launches"

# Step 2: Send an HTTP request to the webpage
headers = {
    "User-Agent": "Mozilla/5.0 (compatible; EducationalDataScienceProject/1.0)"
}

response = requests.get(url, headers=headers, timeout=30)

print("HTTP Status Code:", response.status_code)
response.raise_for_status()

# Step 3: Parse the webpage HTML
soup = BeautifulSoup(response.text, "html.parser")

print("Webpage downloaded and parsed successfully.")

# Step 4: Extract tables from the webpage
tables = pd.read_html(response.text)

print("Number of tables found:", len(tables))

# Step 5: Display information about available tables
for i, table in enumerate(tables):
    print(f"Table {i}: {table.shape[0]} rows, {table.shape[1]} columns")
    print(table.head(2))
    print("-" * 60)

# Step 6: Select a table containing launch records
# Wikipedia's table structure may change, so inspect the
# table previews above and adjust this selection if needed.
launch_table = None

for table in tables:
    column_text = " ".join(str(c).lower() for c in table.columns)

    if "launch" in column_text and (
        "payload" in column_text or "site" in column_text
    ):
        launch_table = table.copy()
        break

# Step 7: Display the scraped launch data
if launch_table is not None:
    print("\nSelected launch table:")
    display(launch_table.head())

    print("\nDataset shape:", launch_table.shape)

    print("\nColumn names:")
    print(launch_table.columns.tolist())

    # Step 8: Check missing values
    print("\nMissing values:")
    print(launch_table.isnull().sum())

    # Step 9: Save the data to CSV
    output_file = "spacex_launches_web_scraping.csv"
    launch_table.to_csv(output_file, index=False)

    print(f"\nData saved successfully as {output_file}")

else:
    print(
        "\nNo matching launch table was detected automatically. "
        "Review the table previews and select the correct table manually."
    )

# Step 10: Conclusion
print("\nWeb scraping process completed.")
