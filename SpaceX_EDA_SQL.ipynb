# ============================================================
# SpaceX Falcon 9 - Exploratory Data Analysis Using SQL
# ============================================================

import requests
import pandas as pd
import sqlite3

# 1. Collect launch data
url = "https://api.spacexdata.com/v4/launches/past"
response = requests.get(url, timeout=30)
response.raise_for_status()
launches = response.json()

df = pd.DataFrame([{
    "flight_number": x.get("flight_number"),
    "name": x.get("name"),
    "date": x.get("date_utc"),
    "success": x.get("success"),
    "rocket": x.get("rocket"),
    "launchpad": x.get("launchpad"),
    "payload_count": len(x.get("payloads") or [])
} for x in launches])

df["date"] = pd.to_datetime(df["date"], errors="coerce", utc=True)
df["year"] = df["date"].dt.year

print("Dataset shape:", df.shape)
display(df.head())

# 2. Create an in-memory SQLite database
connection = sqlite3.connect(":memory:")
df.to_sql("launches", connection, if_exists="replace", index=False)

# 3. Total number of launches
print("Total launches:")
display(pd.read_sql_query("""
SELECT COUNT(*) AS total_launches
FROM launches;
""", connection))

# 4. Successful and unsuccessful launches
print("Launch outcomes:")
display(pd.read_sql_query("""
SELECT
    success,
    COUNT(*) AS launch_count
FROM launches
GROUP BY success
ORDER BY launch_count DESC;
""", connection))

# 5. Launches by year
print("Launches by year:")
display(pd.read_sql_query("""
SELECT
    year,
    COUNT(*) AS total_launches
FROM launches
WHERE year IS NOT NULL
GROUP BY year
ORDER BY year;
""", connection))

# 6. Launches by launchpad
print("Launches by launchpad:")
display(pd.read_sql_query("""
SELECT
    launchpad,
    COUNT(*) AS total_launches
FROM launches
GROUP BY launchpad
ORDER BY total_launches DESC;
""", connection))

# 7. Success rate by launchpad
print("Success rate by launchpad:")
display(pd.read_sql_query("""
SELECT
    launchpad,
    COUNT(*) AS total_launches,
    SUM(CASE WHEN success = 1 THEN 1 ELSE 0 END) AS successful_launches,
    ROUND(
        100.0 * SUM(CASE WHEN success = 1 THEN 1 ELSE 0 END)
        / COUNT(*), 2
    ) AS success_rate_percent
FROM launches
WHERE success IS NOT NULL
GROUP BY launchpad
ORDER BY success_rate_percent DESC;
""", connection))

# 8. Launches with the most payloads
print("Launches by payload count:")
display(pd.read_sql_query("""
SELECT name, payload_count, date
FROM launches
ORDER BY payload_count DESC
LIMIT 10;
""", connection))

# 9. Save the dataset for later notebooks
df.to_csv("spacex_eda_sql_data.csv", index=False)

print("SQL analysis completed.")
connection.close()
