# ============================================================
# SpaceX Falcon 9 - EDA and Data Visualization
# ============================================================

import requests
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme()

# 1. Collect launch data
url = "https://api.spacexdata.com/v4/launches/past"
response = requests.get(url, timeout=30)
response.raise_for_status()
launches = response.json()

df = pd.DataFrame([{
    "flight_number": x.get("flight_number"),
    "name": x.get("name"),
    "date": x.get("date_utc"),
    "success": x.get("success"),
    "rocket": x.get("rocket"),
    "launchpad": x.get("launchpad"),
    "payload_count": len(x.get("payloads") or [])
} for x in launches])

df["date"] = pd.to_datetime(df["date"], errors="coerce", utc=True)
df["year"] = df["date"].dt.year

print("Dataset shape:", df.shape)
display(df.head())

# 2. Launch outcomes
outcomes = df["success"].map({
    True: "Success",
    False: "Failure"
}).fillna("Unknown")

outcomes.value_counts().plot(kind="bar", title="SpaceX Launch Outcomes")
plt.xlabel("Launch Outcome")
plt.ylabel("Number of Launches")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()

# 3. Launches per year
yearly = df.dropna(subset=["year"]).groupby("year").size()

yearly.plot(kind="line", marker="o", title="SpaceX Launches by Year")
plt.xlabel("Year")
plt.ylabel("Number of Launches")
plt.tight_layout()
plt.show()

# 4. Launches by launchpad
launchpad_counts = df["launchpad"].value_counts().head(10)

launchpad_counts.plot(kind="bar", title="Top Launchpads by Launch Count")
plt.xlabel("Launchpad ID")
plt.ylabel("Number of Launches")
plt.xticks(rotation=45, ha="right")
plt.tight_layout()
plt.show()

# 5. Payload count vs launch outcome
sns.boxplot(data=df, x="success", y="payload_count")
plt.title("Payload Count by Launch Outcome")
plt.xlabel("Launch Success (True/False)")
plt.ylabel("Number of Payloads")
plt.tight_layout()
plt.show()

# 6. Success rate by year
success_data = df.dropna(subset=["success", "year"]).copy()
success_data["success_numeric"] = success_data["success"].astype(int)

yearly_success = success_data.groupby("year")["success_numeric"].mean() * 100

yearly_success.plot(
    kind="line", marker="o",
    title="Launch Success Rate by Year"
)
plt.xlabel("Year")
plt.ylabel("Success Rate (%)")
plt.ylim(0, 100)
plt.tight_layout()
plt.show()

# 7. Export data
df.to_csv("spacex_eda_visualization_data.csv", index=False)

print("EDA visualizations completed.")
