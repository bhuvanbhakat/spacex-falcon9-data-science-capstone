# ============================================================
# SpaceX Falcon 9 Data Collection Using API
# ============================================================

import requests
import pandas as pd

# Step 1: Set the SpaceX API URL
api_url = "https://api.spacexdata.com/v4/launches/past"

# Step 2: Send a GET request to the API
response = requests.get(api_url, timeout=30)

# Check whether the request was successful
print("API Status Code:", response.status_code)
response.raise_for_status()

# Step 3: Convert the API response into JSON
data = response.json()

print("Total Launch Records:", len(data))

# Step 4: Convert JSON data into a Pandas DataFrame
df = pd.json_normalize(data)

print("\nOriginal Dataset Shape:", df.shape)

# Step 5: Select relevant columns
columns_to_keep = [
    "flight_number",
    "name",
    "date_utc",
    "success",
    "rocket",
    "launchpad",
    "payloads"
]

available_columns = [
    column for column in columns_to_keep
    if column in df.columns
]

launch_data = df[available_columns].copy()

# Step 6: Display the first five records
print("\nFirst Five Launch Records:")
display(launch_data.head())

# Step 7: Display dataset information
print("\nDataset Information:")
launch_data.info()

# Step 8: Check missing values
print("\nMissing Values:")
print(launch_data.isnull().sum())

# Step 9: Check duplicate records
print("\nNumber of Duplicate Rows:")
print(launch_data.duplicated().sum())

# Step 10: Save the collected data as a CSV file
output_file = "spacex_launches_api.csv"
launch_data.to_csv(output_file, index=False)

print(f"\nDataset saved successfully as {output_file}")

# Step 11: Display the final dataset shape
print("\nFinal Dataset Shape:", launch_data.shape)

# Step 12: Summary
print("\nData Collection Completed Successfully!")
