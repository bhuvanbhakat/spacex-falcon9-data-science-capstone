# ============================================================
# SpaceX Falcon 9 - Interactive Analytics with Folium
# ============================================================

import requests
import pandas as pd
import folium
from IPython.display import display

# 1. Download historical launches
launch_url = "https://api.spacexdata.com/v4/launches/past"
response = requests.get(launch_url, timeout=30)
response.raise_for_status()
launches = response.json()

launch_df = pd.DataFrame([{
    "name": x.get("name"),
    "success": x.get("success"),
    "launchpad": x.get("launchpad"),
    "date": x.get("date_utc")
} for x in launches])

# 2. Download launchpad coordinates
pad_url = "https://api.spacexdata.com/v4/launchpads"
response = requests.get(pad_url, timeout=30)
response.raise_for_status()
pads = response.json()

pad_df = pd.DataFrame([{
    "launchpad": p.get("id"),
    "site_name": p.get("name"),
    "latitude": (p.get("latitude") or 0),
    "longitude": (p.get("longitude") or 0),
    "region": p.get("region")
} for p in pads])

# 3. Summarize launch activity by launchpad
summary = launch_df.groupby("launchpad").agg(
    total_launches=("name", "count"),
    successful_launches=("success", lambda x: x.eq(True).sum())
).reset_index()

summary["success_rate_percent"] = (
    100 * summary["successful_launches"] / summary["total_launches"]
)

summary = summary.merge(pad_df, on="launchpad", how="left")

print("Launchpad summary:")
display(summary)

# 4. Create an interactive map
world_map = folium.Map(
    location=[25, -40],
    zoom_start=2,
    tiles="OpenStreetMap"
)

# 5. Add a marker for each launchpad
for _, row in summary.iterrows():
    if pd.isna(row["latitude"]) or pd.isna(row["longitude"]):
        continue

    popup_text = (
        f"Launchpad: {row['site_name']}<br>"
        f"Region: {row['region']}<br>"
        f"Total launches: {row['total_launches']}<br>"
        f"Successful launches: {row['successful_launches']}<br>"
        f"Success rate: {row['success_rate_percent']:.1f}%"
    )

    folium.Marker(
        location=[row["latitude"], row["longitude"]],
        tooltip=row["site_name"],
        popup=folium.Popup(popup_text, max_width=300),
        icon=folium.Icon(color="blue", icon="rocket", prefix="fa")
    ).add_to(world_map)

# 6. Display and save the map
display(world_map)
world_map.save("spacex_launch_sites_map.html")

print("Interactive map saved as spacex_launch_sites_map.html")
