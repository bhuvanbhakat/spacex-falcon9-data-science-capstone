# ============================================================
# SpaceX Falcon 9 - Plotly Dash Dashboard
# ============================================================

# If needed, run this in a separate notebook cell first:
# %pip install dash plotly pandas requests

import requests
import pandas as pd
import plotly.express as px
from dash import Dash, dcc, html, Input, Output

# 1. Download launch data
url = "https://api.spacexdata.com/v4/launches/past"
response = requests.get(url, timeout=30)
response.raise_for_status()
launches = response.json()

df = pd.DataFrame([{
    "flight_number": x.get("flight_number"),
    "name": x.get("name"),
    "date": x.get("date_utc"),
    "success": x.get("success"),
    "launchpad": x.get("launchpad"),
    "payload_count": len(x.get("payloads") or [])
} for x in launches])

df["date"] = pd.to_datetime(df["date"], errors="coerce", utc=True)
df["year"] = df["date"].dt.year
df["outcome"] = df["success"].map({
    True: "Success",
    False: "Failure"
}).fillna("Unknown")

# 2. Build the Dash app
app = Dash(__name__)

app.layout = html.Div([
    html.H1("SpaceX Falcon 9 Launch Dashboard"),

    html.Label("Select launch year:"),

    dcc.Dropdown(
        id="year-dropdown",
        options=[
            {"label": "All years", "value": "all"}
        ] + [
            {"label": str(int(year)), "value": int(year)}
            for year in sorted(df["year"].dropna().unique())
        ],
        value="all",
        clearable=False
    ),

    dcc.Graph(id="outcome-chart"),
    dcc.Graph(id="payload-chart")
])


@app.callback(
    Output("outcome-chart", "figure"),
    Output("payload-chart", "figure"),
    Input("year-dropdown", "value")
)
def update_dashboard(selected_year):
    filtered = df.copy()

    if selected_year != "all":
        filtered = filtered[filtered["year"] == selected_year]

    outcome_counts = (
        filtered.groupby("outcome")
        .size()
        .reset_index(name="launches")
    )

    outcome_fig = px.pie(
        outcome_counts,
        names="outcome",
        values="launches",
        title="Launch Outcomes"
    )

    payload_fig = px.scatter(
        filtered,
        x="payload_count",
        y="flight_number",
        color="outcome",
        hover_name="name",
        title="Payload Count vs. Flight Number",
        labels={
            "payload_count": "Number of Payloads",
            "flight_number": "Flight Number"
        }
    )

    return outcome_fig, payload_fig


# 3. Start the Dash server
# Run this as the final cell in a local Jupyter environment.
# In Google Colab, additional setup is required to expose the app.
if __name__ == "__main__":
    app.run(debug=False, port=8050)
