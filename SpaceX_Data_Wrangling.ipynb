
# ============================================================
# SpaceX Falcon 9 - Data Wrangling
# ============================================================

import requests
import pandas as pd
import numpy as np

# Step 1: Collect SpaceX launch data from the API
url = "https://api.spacexdata.com/v4/launches/past"

response = requests.get(url, timeout=30)
response.raise_for_status()

launches = response.json()

df = pd.json_normalize(launches)

print("Original dataset shape:", df.shape)
display(df.head())

# Step 2: Select relevant columns
columns = [
    "flight_number",
    "name",
    "date_utc",
    "success",
    "rocket",
    "launchpad",
    "payloads",
    "cores",
    "failures"
]

available_columns = [c for c in columns if c in df.columns]
df = df[available_columns].copy()

# Step 3: Rename columns for readability
df.rename(columns={
    "flight_number": "FlightNumber",
    "name": "LaunchName",
    "date_utc": "Date",
    "success": "LaunchSuccess",
    "rocket": "RocketID",
    "launchpad": "LaunchpadID",
    "payloads": "PayloadIDs",
    "cores": "Cores",
    "failures": "Failures"
}, inplace=True)

# Step 4: Convert launch date to datetime
df["Date"] = pd.to_datetime(df["Date"], errors="coerce", utc=True)

# Step 5: Create useful date features
df["Year"] = df["Date"].dt.year
df["Month"] = df["Date"].dt.month

# Step 6: Check missing values
print("\nMissing values before handling:")
print(df.isnull().sum())

# Step 7: Handle missing launch-success values
if "LaunchSuccess" in df.columns:
    df["LaunchSuccess"] = df["LaunchSuccess"].astype("boolean")

# Step 8: Remove duplicate records
duplicates = df.duplicated().sum()
print("\nDuplicate rows found:", duplicates)

df.drop_duplicates(inplace=True)

# Step 9: Create a readable success label
if "LaunchSuccess" in df.columns:
    df["SuccessLabel"] = df["LaunchSuccess"].map({
        True: "Success",
        False: "Failure"
    })

# Step 10: Display the cleaned dataset
print("\nCleaned dataset:")
display(df.head())

print("\nCleaned dataset shape:", df.shape)

# Step 11: Review data types
print("\nData types:")
print(df.dtypes)

# Step 12: Review missing values after processing
print("\nMissing values after processing:")
print(df.isnull().sum())

# Step 13: Save the cleaned dataset
output_file = "spacex_launches_cleaned.csv"
df.to_csv(output_file, index=False)

print(f"\nCleaned dataset saved as {output_file}")

# Step 14: Summary
print("\nData wrangling completed.")
